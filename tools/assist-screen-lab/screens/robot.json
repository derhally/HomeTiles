{
  "format": 1,
  "id": "robot",
  "name": "Robot",
  "note": "A small robot drawn in outline. Listening: it bobs, its ears glow and sound waves reach its head with the voice, and it blinks now and then. Thinking: its eyes wander up and sideways, the antenna blinks amber and three dots bounce above its head. Answering: its mouth moves with the reply, its eyes turn happy, its cheeks blush and it waves.",
  "label_color": "#BFF4FF",
  "reach": {"half_r": 1.75, "up_r": 1.95, "down_r": 2.4},
  "colors": {"line": "#7FE7FF", "face": "#0B1624", "back": "#05070F", "eye": "#9BF6FF", "glint": "#FFFFFF",
             "amber": "#FFB547", "blush": "#FFB3C9", "mouth": "#9BF6FF"},
  "vars": {
    "answer": {"init": 0, "next": "answer + (answering - answer) * 0.12"},
    "think": "max(0, mode - answer)",
    "listen": "1 - mode",
    "lv": "level",
    "s": "max(2, 0.05 * r)",
    "oy": "sin(t * 2.2) * 0.03 * r * (1 - think) - answer * lv * 0.05 * r",
    "hx": "cx",
    "hy": "cy - 0.35 * r + oy",
    "hw": "1.1 * r",
    "hh": "0.8 * r",
    "by": "cy + 1.05 * r + oy * 0.5",
    "bw": "0.7 * r",
    "bh": "0.42 * r",
    "bp": "mod(t, 3.7)",
    "blink": "bp < 0.16 ? sin(bp / 0.16 * pi) : 0",
    "gx": "think * 0.13 * r * sin(t * 1.3)",
    "gy": "-think * 0.09 * r - listen * 0.02 * r * lv",
    "ex": "0.45 * r",
    "eh": "0.34 * r * (1 - 0.9 * blink)",
    "rest": "1 - think - answer",
    "lhx": "hx - bw - 0.28 * r",
    "lhy": "by + bh * 0.65 - 0.04 * r * sin(t * 2.2)",
    "rhx": "rest * (hx + bw + 0.28 * r) + think * (hx + 0.55 * r) + answer * (hx + bw + 0.42 * r + 0.14 * r * sin(t * 6))",
    "rhy": "rest * (by + bh * 0.65 + 0.04 * r * sin(t * 2.2)) + think * (hy + hh + 0.12 * r) + answer * (by - bh - 0.5 * r)"
  },
  "items": [
    {"type": "line", "note": "antenna", "x1": "hx", "y1": "hy - hh", "x2": "hx", "y2": "hy - hh - 0.42 * r",
     "width": "s", "color": "line"},
    {"type": "disc", "note": "antenna bulb glow", "x": "hx", "y": "hy - hh - 0.5 * r", "radius": "max(1, 0.22 * r)",
     "color": "think > 0.3 ? amber : line", "alpha": "0.12 + 0.18 * (listen * lv + think * (0.5 + 0.5 * sin(t * 8)))"},
    {"type": "disc", "note": "antenna bulb", "x": "hx", "y": "hy - hh - 0.5 * r", "radius": "max(1, 0.1 * r)",
     "color": "think > 0.3 ? amber : line", "alpha": "think > 0.3 ? 0.55 + 0.45 * sin(t * 8) : 1"},

    {"type": "disc", "note": "ears, half hidden behind the head", "repeat": 2, "as": "k",
     "x": "hx + (k * 2 - 1) * hw", "y": "hy", "radius": "max(1, 0.2 * r)", "color": "line"},
    {"type": "disc", "note": "ears glow with the voice", "repeat": 2, "as": "k",
     "x": "hx + (k * 2 - 1) * hw", "y": "hy", "radius": "max(1, 0.2 * r - s)", "color": "eye",
     "alpha": "0.15 + 0.85 * clamp01(listen * lv * 1.4)"},

    {"type": "rect", "note": "head outline", "x1": "hx - hw", "y1": "hy - hh", "x2": "hx + hw", "y2": "hy + hh",
     "radius": "0.32 * r", "color": "line"},
    {"type": "rect", "note": "face", "x1": "hx - hw + s", "y1": "hy - hh + s", "x2": "hx + hw - s", "y2": "hy + hh - s",
     "radius": "0.32 * r - s", "color": "face"},

    {"type": "rect", "note": "eyes, blinking now and then", "repeat": 2, "as": "k",
     "let": {"x": "hx + (k * 2 - 1) * ex + gx", "y": "hy - 0.08 * r + gy"},
     "x1": "x - 0.15 * r", "y1": "y - eh / 2", "x2": "x + 0.15 * r", "y2": "y + eh / 2",
     "radius": 1000, "color": "eye", "alpha": "1 - answer"},
    {"type": "disc", "note": "eye glints", "repeat": 2, "as": "k",
     "x": "hx + (k * 2 - 1) * ex + gx - 0.05 * r", "y": "hy - 0.08 * r + gy - 0.07 * r",
     "radius": "max(1, 0.045 * r)", "color": "glint", "alpha": "(1 - answer) * (1 - blink)"},
    {"type": "arc", "note": "happy eyes while answering", "repeat": 2, "as": "k",
     "x": "hx + (k * 2 - 1) * ex", "y": "hy - 0.02 * r", "radius": "0.16 * r", "start": 205, "end": 335,
     "width": "s * 1.4", "color": "eye", "alpha": "answer"},

    {"type": "arc", "note": "smile while listening", "x": "hx", "y": "hy + 0.12 * r", "radius": "0.26 * r",
     "start": 30, "end": 150, "width": "s", "color": "mouth", "alpha": "(1 - answer) * (1 - think)"},
    {"type": "rect", "note": "a small hmm while thinking", "x1": "hx + 0.05 * r", "y1": "hy + 0.36 * r - s / 2",
     "x2": "hx + 0.3 * r", "y2": "hy + 0.36 * r + s / 2", "radius": 1000, "color": "mouth", "alpha": "think"},
    {"type": "rect", "note": "mouth talking with the reply",
     "let": {"mh": "0.05 * r + answer * lv * 0.3 * r"},
     "x1": "hx - 0.24 * r", "y1": "hy + 0.42 * r - mh / 2", "x2": "hx + 0.24 * r", "y2": "hy + 0.42 * r + mh / 2",
     "radius": 1000, "color": "mouth", "alpha": "answer"},
    {"type": "line", "note": "blush while answering: two short soft strokes under each eye", "repeat": 4, "as": "k",
     "let": {"side": "k < 2 ? -1 : 1", "n": "mod(k, 2)", "bx0": "hx + side * (0.62 + n * 0.1) * r", "byy": "hy + 0.24 * r"},
     "x1": "bx0 - 0.03 * r", "y1": "byy + 0.05 * r", "x2": "bx0 + 0.03 * r", "y2": "byy - 0.05 * r",
     "width": "s", "color": "blush", "alpha": "answer * 0.8"},

    {"type": "rect", "note": "neck", "x1": "hx - 0.12 * r", "y1": "hy + hh", "x2": "hx + 0.12 * r", "y2": "by - bh",
     "color": "line"},
    {"type": "rect", "note": "body outline", "x1": "hx - bw", "y1": "by - bh", "x2": "hx + bw", "y2": "by + bh",
     "radius": "0.2 * r", "color": "line"},
    {"type": "rect", "note": "body", "x1": "hx - bw + s", "y1": "by - bh + s", "x2": "hx + bw - s", "y2": "by + bh - s",
     "radius": "0.2 * r - s", "color": "face"},
    {"type": "disc", "note": "chest light, brighter with the voice", "x": "hx", "y": "by", "radius": "max(1, 0.12 * r)",
     "color": "think > 0.3 ? amber : eye", "alpha": "0.35 + 0.65 * clamp01(lv * 1.3 + think * (0.5 + 0.5 * sin(t * 4)))"},

    {"type": "line", "note": "left arm hangs and sways", "x1": "hx - bw", "y1": "by - bh * 0.4",
     "x2": "lhx", "y2": "lhy", "width": "s * 1.6", "color": "line"},
    {"type": "disc", "note": "left hand", "x": "lhx", "y": "lhy", "radius": "max(1, 0.07 * r)", "color": "line"},
    {"type": "line", "note": "right arm: hangs, a hand to the chin while thinking, waves while answering",
     "x1": "hx + bw", "y1": "by - bh * 0.4", "x2": "rhx", "y2": "rhy", "width": "s * 1.6", "color": "line"},
    {"type": "disc", "note": "right hand", "x": "rhx", "y": "rhy", "radius": "max(1, 0.07 * r)", "color": "line"},

    {"type": "arc", "note": "sound waves reaching the ears while listening", "repeat": 6, "as": "k",
     "let": {"side": "k < 3 ? 1 : -1", "n": "mod(k, 3)", "start": "side > 0 ? -35 : 145"},
     "x": "hx + side * hw", "y": "hy", "radius": "(0.38 + n * 0.16) * r", "start": "start", "end": "start + 70",
     "width": "s", "color": "eye", "alpha": "listen * clamp01(lv * 1.6 - n * 0.3)"},

    {"type": "disc", "note": "thinking dots", "repeat": 3, "as": "k",
     "x": "hx + hw * 0.7 + k * 0.24 * r",
     "y": "hy - hh - 0.25 * r - 0.1 * r * max(0, sin(t * 4.5 - k * 0.9))",
     "radius": "max(1, 0.065 * r)", "color": "eye", "alpha": "think"}
  ]
}
