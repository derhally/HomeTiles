{
  "format": 1,
  "id": "holo",
  "name": "Holo",
  "note": "A cyberpunk hologram of a woman's face above a projector: a cyan wireframe with magenta accents, scanlines, flicker and glitch shifts. Listening, her eyes glow and voice rings pulse with the voice. Thinking, her gaze drifts up, data rings orbit and the glitches come more often. Answering, her lips move with the reply.",
  "label_color": "#7FF6FF",
  "reach": {"half_r": 1.75, "up_r": 1.75, "down_r": 2.3, "label_r": 1.95},
  "colors": {"cyan": "#4FF2FF", "ice": "#C8FCFF", "magenta": "#FF3FD2", "violet": "#9A5CFF", "deep": "#0A1830"},
  "vars": {
    "answer": {"init": 0, "next": "answer + (answering - answer) * 0.12"},
    "think": "max(0, mode - answer)",
    "listen": "1 - mode",
    "lv": "level",
    "s": "max(1, 0.018 * r)",
    "glitch": {"init": 0, "next": "rand(0, 99) < 4 + think * 14 ? rand(-14, 14) * r / 102 : 0", "every": 0.09},
    "flick": {"init": 1, "next": "rand(0, 99) < 6 ? 0.55 : 0.85 + 0.15 * frand()", "every": 0.05},
    "bob": "sin(t * 1.3) * 0.03 * r",
    "fx": "cx + glitch",
    "fy": "cy - 0.1 * r + bob",
    "rx": "0.66 * r",
    "ry": "0.92 * r",
    "a": "0.75 * flick",
    "bp": "mod(t, 4.1)",
    "blink": "bp < 0.15 ? sin(bp / 0.15 * pi) : 0",
    "gx": "think * 0.05 * r * sin(t * 0.9)",
    "gy": "-think * 0.045 * r",
    "open": "answer * lv * 0.16 * r",
    "scan": "mod(t * 0.45, 1)"
  },
  "items": [
    {"type": "line", "note": "projector beam: faint lines from the emitter to the face", "repeat": 7, "as": "k", "round": false,
     "let": {"u": "(k - 3) / 3"},
     "x1": "cx + u * 0.18 * r", "y1": "cy + 1.42 * r", "x2": "fx + u * rx * 1.15", "y2": "fy + 0.2 * r",
     "width": 1, "color": "cyan", "alpha": "0.07 * flick"},
    {"type": "poly", "note": "emitter ring", "count": 33, "width": "s * 1.4", "color": "cyan",
     "x": "cx + 0.42 * r * cos(u * tau)", "y": "cy + 1.45 * r + 0.08 * r * sin(u * tau)", "alpha": 0.8},
    {"type": "poly", "note": "emitter ring, outer", "count": 33, "width": 1, "color": "magenta",
     "x": "cx + 0.62 * r * cos(u * tau)", "y": "cy + 1.45 * r + 0.12 * r * sin(u * tau)", "alpha": "0.35 + 0.4 * lv"},

    {"type": "line", "note": "scanlines over the hologram", "repeat": 26, "as": "k", "round": false,
     "x1": "fx - 1.1 * r", "y1": "fy - 1.15 * r + k * 0.095 * r", "x2": "fx + 1.1 * r", "y2": "fy - 1.15 * r + k * 0.095 * r",
     "width": 1, "color": "cyan", "alpha": 0.05},

    {"type": "poly", "note": "hair, back strands falling past the shoulders", "count": 18, "width": "s", "color": "violet",
     "let": {"sw": "sin(t * 0.8) * 0.04 * r"},
     "x": "fx - rx * (1.12 + 0.28 * u * u) - sw * u", "y": "fy - ry * 0.25 + u * 1.45 * r", "alpha": "a * 0.75"},
    {"type": "poly", "count": 18, "width": "s", "color": "violet",
     "let": {"sw": "sin(t * 0.8 + 1) * 0.04 * r"},
     "x": "fx + rx * (1.12 + 0.28 * u * u) + sw * u", "y": "fy - ry * 0.25 + u * 1.45 * r", "alpha": "a * 0.75"},
    {"type": "poly", "note": "hair crown, a swept arc over the head", "count": 24, "width": "s * 1.4", "color": "violet",
     "x": "fx + (rx * 1.12) * cos(pi + u * pi)", "y": "fy - ry * 0.25 + (ry * 0.95) * sin(pi + u * pi)", "alpha": "a"},
    {"type": "poly", "note": "side-swept fringe", "count": 16, "width": "s * 1.2", "color": "magenta",
     "x": "fx + rx * (0.85 - 1.5 * u)", "y": "fy - ry * (0.95 - 0.6 * u * u) - 0.05 * r * sin(u * pi)", "alpha": "a * 0.9"},

    {"type": "poly", "note": "face outline: rounded brow, high cheeks, narrow chin", "count": 64, "width": "s * 1.6", "color": "cyan",
     "glow": true,
     "x": "fx + rx * sin(u * tau) * (1 - 0.42 * pow(max(0, -cos(u * tau)), 2.2))",
     "y": "fy - ry * cos(u * tau) * (cos(u * tau) < 0 ? 1.08 : 0.92)", "alpha": "a"},
    {"type": "line", "note": "contour lines across the face", "repeat": 9, "as": "k", "round": false,
     "let": {"q": "(k + 1) / 10 * pi", "half": "rx * sin(q) * (1 - 0.42 * pow(max(0, -cos(q)), 2.2)) * 0.96",
             "y": "fy - ry * cos(q) * (cos(q) < 0 ? 1.08 : 0.92)"},
     "x1": "fx - half", "y1": "y", "x2": "fx + half", "y2": "y",
     "width": 1, "color": "cyan", "alpha": "a * (0.12 + 0.5 * (abs(y - (fy - ry + scan * 2.1 * ry)) < 0.05 * r ? 1 : 0))"},
    {"type": "line", "note": "neck", "repeat": 2, "as": "k",
     "x1": "fx + (k * 2 - 1) * 0.24 * r", "y1": "fy + 0.78 * r", "x2": "fx + (k * 2 - 1) * 0.26 * r", "y2": "fy + 1.2 * r",
     "width": "s", "color": "cyan", "alpha": "a * 0.8"},

    {"type": "arc", "note": "brows", "repeat": 2, "as": "k",
     "let": {"side": "k * 2 - 1"},
     "x": "fx + side * 0.27 * r", "y": "fy - 0.05 * r + gy * 0.5", "radius": "0.22 * r",
     "start": "side < 0 ? 228 : 252", "end": "side < 0 ? 288 : 312", "width": "s * 1.3", "color": "ice", "alpha": "a"},
    {"type": "arc", "note": "upper lids (almond eyes)", "repeat": 2, "as": "k",
     "let": {"side": "k * 2 - 1"},
     "x": "fx + side * 0.27 * r", "y": "fy + 0.12 * r + blink * 0.05 * r", "radius": "0.16 * r",
     "start": 218, "end": 322, "width": "s * 1.4", "color": "ice", "alpha": "a"},
    {"type": "arc", "note": "lower lids", "repeat": 2, "as": "k",
     "let": {"side": "k * 2 - 1"},
     "x": "fx + side * 0.27 * r", "y": "fy - 0.01 * r", "radius": "0.14 * r",
     "start": 40, "end": 140, "width": 1, "color": "cyan", "alpha": "a * 0.8 * (1 - blink)"},
    {"type": "line", "note": "lashes at the outer corners", "repeat": 4, "as": "k",
     "let": {"side": "k < 2 ? -1 : 1", "n": "mod(k, 2)", "ex": "fx + side * 0.41 * r", "ey": "fy + 0.035 * r - n * 0.03 * r"},
     "x1": "ex", "y1": "ey", "x2": "ex + side * 0.07 * r", "y2": "ey - 0.04 * r - n * 0.02 * r",
     "width": "s", "color": "ice", "alpha": "a * 0.9"},
    {"type": "disc", "note": "irises glow with the voice", "repeat": 2, "as": "k",
     "let": {"side": "k * 2 - 1"},
     "x": "fx + side * 0.27 * r + gx", "y": "fy + 0.035 * r + gy", "radius": "max(1, 0.055 * r * (1 - blink))",
     "color": "think > 0.3 ? magenta : cyan", "alpha": "a * (0.55 + 0.45 * (listen * lv + think * (0.5 + 0.5 * sin(t * 5))))"},
    {"type": "disc", "note": "pupils", "repeat": 2, "as": "k",
     "x": "fx + (k * 2 - 1) * 0.27 * r + gx", "y": "fy + 0.035 * r + gy", "radius": "max(1, 0.02 * r * (1 - blink))",
     "color": "ice", "alpha": "a"},

    {"type": "line", "note": "nose", "repeat": 2, "as": "k",
     "x1": "k == 0 ? fx + 0.01 * r : fx + 0.045 * r", "y1": "k == 0 ? fy + 0.12 * r : fy + 0.36 * r",
     "x2": "k == 0 ? fx + 0.045 * r : fx - 0.04 * r", "y2": "k == 0 ? fy + 0.36 * r : fy + 0.4 * r",
     "width": "s", "color": "cyan", "alpha": "a * 0.7"},

    {"type": "line", "note": "upper lip with a cupid's bow: four strokes", "repeat": 4, "as": "k",
     "let": {"lift": "open * 0.3",
             "xa": "k == 0 ? -0.2 : k == 1 ? -0.06 : k == 2 ? 0 : 0.06",
             "ya": "k == 0 ? 0.56 : k == 1 ? 0.51 : k == 2 ? 0.535 : 0.51",
             "xb": "k == 0 ? -0.06 : k == 1 ? 0 : k == 2 ? 0.06 : 0.2",
             "yb": "k == 0 ? 0.51 : k == 1 ? 0.535 : k == 2 ? 0.51 : 0.56"},
     "x1": "fx + xa * r", "y1": "fy + ya * r - (k == 0 ? 0 : lift)", "x2": "fx + xb * r", "y2": "fy + yb * r - (k == 3 ? 0 : lift)",
     "width": "s * 1.4", "color": "magenta", "alpha": "a"},
    {"type": "poly", "note": "lower lip, dropping as she talks", "count": 12, "width": "s * 1.4", "color": "magenta",
     "x": "fx - 0.2 * r + u * 0.4 * r", "y": "fy + 0.56 * r + (0.05 * r + open) * sin(u * pi)", "alpha": "a"},
    {"type": "line", "note": "mouth line while closed", "round": false, "x1": "fx - 0.17 * r", "y1": "fy + 0.565 * r",
     "x2": "fx + 0.17 * r", "y2": "fy + 0.565 * r", "width": 1, "color": "magenta", "alpha": "a * 0.6 * (1 - clamp01(open / (0.03 * r)))"},

    {"type": "arc", "note": "voice rings around the head while listening", "repeat": 3, "as": "k",
     "x": "fx", "y": "fy", "radius": "(1.25 + k * 0.14 + lv * 0.1) * r", "start": "200 + k * 7", "end": "340 - k * 7",
     "width": 1, "color": "cyan", "alpha": "listen * clamp01(lv * 1.5 - k * 0.3) * flick"},
    {"type": "arc", "note": "data rings orbiting while thinking", "repeat": 6, "as": "k", "round": false,
     "let": {"s0": "t * (k < 3 ? 60 : -42) + k * 60"},
     "x": "fx", "y": "fy", "radius": "(k < 3 ? 1.32 : 1.44) * r", "start": "s0", "end": "s0 + 34",
     "width": "k < 3 ? s * 2 : s", "color": "k < 3 ? magenta : cyan", "alpha": "think * 0.8 * flick"},

    {"type": "rect", "note": "a glitch slice now and then", "if": "glitch != 0",
     "x1": "fx - 0.9 * r + glitch * 3", "y1": "fy - 0.3 * r + mod(t * 97, 1) * 0.9 * r",
     "x2": "fx + 0.6 * r + glitch * 3", "y2": "fy - 0.28 * r + mod(t * 97, 1) * 0.9 * r",
     "color": "magenta", "alpha": 0.35},

    {"type": "text", "note": "readouts (wide screens)", "on": ["wide"], "x": "cx - 2.15 * r", "y": "fy + 0.3 * r", "box_width": 120, "font": 16,
     "text": "ID 0451", "color": "cyan", "alpha": "0.7 * flick"},
    {"type": "text", "on": ["wide"], "x": "cx - 2.15 * r", "y": "fy + 0.5 * r", "box_width": 120, "font": 16,
     "text": "VOX {lv * 99:02d}", "color": "magenta", "alpha": "0.7 * flick", "frames": 3},
    {"type": "text", "on": ["wide"], "x": "cx + 1.55 * r", "y": "fy + 0.3 * r", "box_width": 120, "font": 16,
     "text": "SYNC {mod(t * 7, 100):02d}", "color": "cyan", "alpha": "0.7 * flick", "frames": 4}
  ]
}
