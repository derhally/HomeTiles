{
  "format": 1,
  "id": "retro_robot",
  "name": "Retro Robot",
  "note": "A tall tin-can robot head with a dome, an antenna, a wide visor and a grille mouth. Listening: its eyes glance about and the antenna ball glows with the voice. Thinking: its lids droop, its eyes roll up and a question mark bobs beside it. Answering: the grille teeth part with each word.",
  "label_color": "#D8DEE4",
  "reach": {"half_r": 1.5, "up_r": 2.5, "down_r": 2.0, "label_r": 1.6},
  "colors": {"metal": "#A9B4C0", "shade": "#7F8A96", "edge": "#2A3038", "visor": "#15181D", "white": "#F2F2EE",
             "pupil": "#101114", "mouth": "#DCE2E8", "amber": "#FFB547", "ball": "#C8D0D8"},
  "vars": {
    "answer": {"init": 0, "next": "answer + (answering - answer) * 0.12"},
    "think": "max(0, mode - answer)",
    "listen": "1 - mode",
    "lv": "level",
    "R": "r * 1.25",
    "s": "max(2, 0.035 * r)",
    "oy": "sin(t * 2) * 0.025 * R - answer * lv * 0.04 * R",
    "hx": "cx",
    "hy": "cy - 0.15 * R + oy",
    "hw": "0.62 * R",
    "top": "hy - 0.7 * R",
    "bot": "hy + 1.0 * R",
    "glance": {"init": 0, "next": "rand(-100, 100) / 100", "every": 1.6},
    "gx": "listen * 0.06 * R * glance + think * 0.05 * R * sin(t * 1.4)",
    "gy": "-think * 0.07 * R",
    "lid": "think * 0.55 + listen * 0.15 * (1 - lv)",
    "bp": "mod(t, 4.3)",
    "blink": "bp < 0.14 ? sin(bp / 0.14 * pi) : 0",
    "open": "answer * (0.04 * R + lv * 0.16 * R)"
  },
  "items": [
    {"type": "line", "note": "antenna", "x1": "hx", "y1": "top - hw + 0.05 * R", "x2": "hx", "y2": "top - hw - 0.36 * R",
     "width": "s * 1.6", "color": "edge"},
    {"type": "disc", "note": "antenna glow", "x": "hx", "y": "top - hw - 0.42 * R", "radius": "max(1, 0.18 * R)",
     "color": "think > 0.3 ? amber : ball", "alpha": "0.1 + 0.25 * (listen * lv + think * (0.5 + 0.5 * sin(t * 7)))"},
    {"type": "disc", "note": "antenna ball", "x": "hx", "y": "top - hw - 0.42 * R", "radius": "max(1, 0.075 * R + s)",
     "color": "edge"},
    {"type": "disc", "x": "hx", "y": "top - hw - 0.42 * R", "radius": "max(1, 0.075 * R)",
     "color": "think > 0.3 ? amber : ball", "alpha": "think > 0.3 ? 0.6 + 0.4 * sin(t * 7) : 1"},
    {"type": "rect", "note": "antenna foot", "x1": "hx - 0.1 * R", "y1": "top - hw - 0.02 * R", "x2": "hx + 0.1 * R",
     "y2": "top - hw + 0.1 * R", "radius": "0.03 * R", "color": "edge"},

    {"type": "disc", "note": "dome", "x": "hx", "y": "top", "radius": "max(1, hw + s)", "color": "edge"},
    {"type": "disc", "x": "hx", "y": "top", "radius": "max(1, hw)", "color": "metal"},
    {"type": "rect", "note": "can", "x1": "hx - hw - s", "y1": "top", "x2": "hx + hw + s", "y2": "bot + s",
     "radius": "0.1 * R", "color": "edge"},
    {"type": "rect", "x1": "hx - hw", "y1": "top", "x2": "hx + hw", "y2": "bot", "radius": "0.08 * R", "color": "metal"},
    {"type": "rect", "note": "shading down the can", "x1": "hx + hw * 0.55", "y1": "top", "x2": "hx + hw", "y2": "bot",
     "radius": "0.08 * R", "color": "shade", "alpha": 0.6},

    {"type": "rect", "note": "visor", "x1": "hx - hw - s", "y1": "hy - 0.42 * R", "x2": "hx + hw + s", "y2": "hy + 0.06 * R",
     "radius": 1000, "color": "visor"},
    {"type": "rect", "note": "eyes", "repeat": 2, "as": "k",
     "let": {"x": "hx + (k * 2 - 1) * 0.27 * R"},
     "x1": "x - 0.19 * R", "y1": "hy - 0.34 * R", "x2": "x + 0.19 * R", "y2": "hy - 0.02 * R",
     "radius": "0.09 * R", "color": "white"},
    {"type": "rect", "note": "pupils", "repeat": 2, "as": "k",
     "let": {"x": "hx + (k * 2 - 1) * 0.27 * R + gx", "y": "hy - 0.17 * R + gy"},
     "x1": "x - 0.05 * R", "y1": "y - 0.05 * R", "x2": "x + 0.05 * R", "y2": "y + 0.05 * R",
     "radius": "0.015 * R", "color": "pupil"},
    {"type": "rect", "note": "lids: droop while thinking, close when it blinks", "repeat": 2, "as": "k",
     "let": {"x": "hx + (k * 2 - 1) * 0.27 * R", "lh": "0.32 * R * clamp01(max(lid, blink))"},
     "if": "lh >= 1",
     "x1": "x - 0.2 * R", "y1": "hy - 0.35 * R", "x2": "x + 0.2 * R", "y2": "hy - 0.35 * R + lh",
     "color": "visor"},

    {"type": "rect", "note": "grille mouth", "x1": "hx - 0.42 * R - s", "y1": "hy + 0.3 * R - s - open / 2",
     "x2": "hx + 0.42 * R + s", "y2": "hy + 0.66 * R + s + open / 2", "radius": "0.1 * R", "color": "edge"},
    {"type": "rect", "x1": "hx - 0.42 * R", "y1": "hy + 0.3 * R - open / 2", "x2": "hx + 0.42 * R",
     "y2": "hy + 0.66 * R + open / 2", "radius": "0.08 * R", "color": "mouth"},
    {"type": "rect", "note": "the gap between the teeth while it talks", "if": "open >= 1",
     "x1": "hx - 0.42 * R", "y1": "hy + 0.48 * R - open / 2", "x2": "hx + 0.42 * R", "y2": "hy + 0.48 * R + open / 2",
     "color": "visor"},
    {"type": "line", "note": "teeth: upper and lower row", "repeat": 10, "as": "k", "round": false,
     "let": {"col": "mod(k, 5)", "row": "floor(k / 5)",
             "x": "hx - 0.42 * R + (col + 1) * 0.84 * R / 6",
             "ya": "row == 0 ? hy + 0.3 * R - open / 2 : hy + 0.48 * R + open / 2",
             "yb": "row == 0 ? hy + 0.48 * R - open / 2 : hy + 0.66 * R + open / 2"},
     "x1": "x", "y1": "ya", "x2": "x", "y2": "yb", "width": "s * 0.8", "color": "edge"},
    {"type": "line", "note": "the bite line when closed", "round": false, "x1": "hx - 0.42 * R", "y1": "hy + 0.48 * R",
     "x2": "hx + 0.42 * R", "y2": "hy + 0.48 * R", "width": "s * 0.8", "color": "edge", "alpha": "open < 1 ? 1 : 0"},

    {"type": "rect", "note": "neck", "x1": "hx - 0.38 * R - s", "y1": "bot", "x2": "hx + 0.38 * R + s",
     "y2": "bot + 0.22 * R", "color": "edge"},
    {"type": "rect", "x1": "hx - 0.38 * R", "y1": "bot + s", "x2": "hx + 0.38 * R", "y2": "bot + 0.22 * R - s",
     "color": "shade"},

    {"type": "text", "note": "a question mark bobs while it thinks", "x": "hx + hw + 0.18 * R",
     "y": "top - 0.35 * R - 0.08 * R * sin(t * 3)", "box_width": 60, "font": 48, "text": "?",
     "color": "amber", "alpha": "think"}
  ]
}
