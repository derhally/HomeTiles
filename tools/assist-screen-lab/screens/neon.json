{
  "format": 1,
  "id": "neon",
  "name": "Neon",
  "note": "A cyberpunk hologram of a woman's face over a projector pad. Listening: the voice bars rise from the pad and her implant glows with the voice; she blinks now and then. Thinking: her eyes look up, her brows lift, the implant lights chase, data scrolls beside her and the image glitches more. Answering: her lips move with the reply and her eyes smile.",
  "label_color": "#BDFBFF",
  "reach": {
    "half_r": 2.45,
    "up_r": 1.85,
    "down_r": 1.75
  },
  "colors": {
    "cyan": "#4DF3FF",
    "magenta": "#FF3EC8",
    "yellow": "#FFE23A",
    "iris": "#FF5FD2",
    "white": "#FFFFFF",
    "back": "#05070F"
  },
  "vars": {
    "answer": {
      "init": 0,
      "next": "answer + (answering - answer) * 0.12"
    },
    "think": "max(0, mode - answer)",
    "listen": "1 - mode",
    "lv": "level",
    "lw": "max(2, 0.025 * r)",
    "gl": {
      "init": 0,
      "next": "rand(0, 99) < 3 + 22 * think ? rand(-8, 8) * r / 100 : 0",
      "every": 0.12
    },
    "fl": {
      "init": 1,
      "next": "0.8 + rand(0, 20) / 100 + 0.1 * answer * level",
      "every": 0.08
    },
    "scan": {
      "init": 0,
      "next": "fract(scan + dt * (0.35 + 0.9 * think))"
    },
    "fx": "cx + gl",
    "fy": "cy - 0.32 * r + sin(t * 1.3) * 0.035 * r",
    "by": "fy + 1.8 * r",
    "bp": "mod(t, 4.3)",
    "blink": "bp < 0.18 ? sin(bp / 0.18 * pi) : 0",
    "eopen": "1 - 0.92 * blink",
    "squint": "answer * 0.18",
    "gzx": "-think * 0.06 * r + listen * 0.02 * r * sin(t * 0.7)",
    "gzy": "-think * 0.035 * r",
    "my": "fy + 0.5 * r",
    "smile": "answer * 0.03 * r",
    "mo": {
      "init": 0,
      "next": "mo + (answer * level * 0.16 * r - mo) * 0.45"
    }
  },
  "layouts": {
    "square": {
      "reach": {
        "half_r": 1.25
      }
    },
    "tall": {
      "reach": {
        "half_r": 1.25
      }
    }
  },
