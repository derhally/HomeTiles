{
  "format": 1,
  "id": "light_disc",
  "name": "Light Disc",
  "note": "A glowing disc on a dark grid. Eight ring segments light with the voice; while thinking the disc turns and two light trails, cyan and orange, race the grid in right angles behind it; while answering the rings pulse with the reply. Each trail keeps its last nine corners (keep, prev).",
  "needs": ["tear_free"],
  "label_color": "#EFFFFF",
  "reach": {"half_r": 1.75, "side_px": 22},
  "colors": {"cyan": "#5FF4FF", "orange": "#FF9A2E", "white": "#EFFFFF", "back": "#05070F"},
  "vars": {
    "answer": {"init": 0, "next": "answer + (answering - answer) * 0.12"},
    "think": "max(0, mode - answer)",
    "gs": "r * 0.63",
    "trail": "6.3 * gs",
    "adv": "st && mode > 0.05 ? dt * 2.4 * r : 0",
    "p_nx": "p_x + p_dx * p_rem",
    "p_ny": "p_y + p_dy * p_rem",
    "p_arr": "adv > 0 && adv >= p_rem",
    "p_rnd": "rand(0, 199)",
    "p_lok": "!(p_nx + p_dy * gs < gs || p_nx + p_dy * gs > w - gs || p_ny - p_dx * gs < gs || p_ny - p_dx * gs > h - gs)",
    "p_rok": "!(p_nx - p_dy * gs < gs || p_nx - p_dy * gs > w - gs || p_ny + p_dx * gs < gs || p_ny + p_dx * gs > h - gs)",
    "p_pick": "!(mod(p_rnd, 100) < 30 || (p_nx + p_dx * gs < gs || p_nx + p_dx * gs > w - gs || p_ny + p_dy * gs < gs || p_ny + p_dy * gs > h - gs)) ? 0 : (p_lok && p_rok ? (p_rnd >= 100 ? 1 : 2) : (p_lok ? 1 : (p_rok ? 2 : 3)))",
    "p_ndx": "p_pick == 0 ? p_dx : p_pick == 1 ? p_dy : p_pick == 2 ? -p_dy : -p_dx",
    "p_ndy": "p_pick == 0 ? p_dy : p_pick == 1 ? -p_dx : p_pick == 2 ? p_dx : -p_dy",
    "p_turn": "p_arr && p_pick != 0",
    "p_cx": {"init": 0, "next": "!st ? 2 * gs : (p_turn ? p_nx : p_cx)", "keep": 8, "record": "!st || p_turn"},
    "p_cy": {"init": 0, "next": "!st ? 2 * gs : (p_turn ? p_ny : p_cy)", "keep": 8, "record": "!st || p_turn"},
    "p_cd": {"init": 0, "next": "!st ? 0 : (p_turn ? p_dist + p_rem : p_cd)", "keep": 8, "record": "!st || p_turn"},
    "p_dist": {"init": 0, "next": "!st ? 0 : p_dist + adv"},
    "p_x": {"init": 0, "next": "!st ? 2 * gs : (p_arr ? p_nx + p_ndx * (adv - p_rem) : p_x + p_dx * adv)"},
    "p_y": {"init": 0, "next": "!st ? 2 * gs : (p_arr ? p_ny + p_ndy * (adv - p_rem) : p_y + p_dy * adv)"},
    "p_dx": {"init": 0, "next": "!st ? 1 : (p_arr ? p_ndx : p_dx)"},
    "p_dy": {"init": 0, "next": "!st ? 0 : (p_arr ? p_ndy : p_dy)"},
    "p_rem": {"init": 0, "next": "!st ? gs : (p_arr ? gs - (adv - p_rem) : p_rem - adv)"},
    "q_nx": "q_x + q_dx * q_rem",
    "q_ny": "q_y + q_dy * q_rem",
    "q_arr": "adv > 0 && adv >= q_rem",
    "q_rnd": "rand(0, 199)",
    "q_lok": "!(q_nx + q_dy * gs < gs || q_nx + q_dy * gs > w - gs || q_ny - q_dx * gs < gs || q_ny - q_dx * gs > h - gs)",
    "q_rok": "!(q_nx - q_dy * gs < gs || q_nx - q_dy * gs > w - gs || q_ny + q_dx * gs < gs || q_ny + q_dx * gs > h - gs)",
    "q_pick": "!(mod(q_rnd, 100) < 30 || (q_nx + q_dx * gs < gs || q_nx + q_dx * gs > w - gs || q_ny + q_dy * gs < gs || q_ny + q_dy * gs > h - gs)) ? 0 : (q_lok && q_rok ? (q_rnd >= 100 ? 1 : 2) : (q_lok ? 1 : (q_rok ? 2 : 3)))",
    "q_ndx": "q_pick == 0 ? q_dx : q_pick == 1 ? q_dy : q_pick == 2 ? -q_dy : -q_dx",
    "q_ndy": "q_pick == 0 ? q_dy : q_pick == 1 ? -q_dx : q_pick == 2 ? q_dx : -q_dy",
    "q_turn": "q_arr && q_pick != 0",
    "q_cx": {"init": 0, "next": "!st ? floor((w - 2 * gs) / gs) * gs : (q_turn ? q_nx : q_cx)", "keep": 8, "record": "!st || q_turn"},
    "q_cy": {"init": 0, "next": "!st ? floor((h - 2 * gs) / gs) * gs : (q_turn ? q_ny : q_cy)", "keep": 8, "record": "!st || q_turn"},
    "q_cd": {"init": 0, "next": "!st ? 0 : (q_turn ? q_dist + q_rem : q_cd)", "keep": 8, "record": "!st || q_turn"},
    "q_dist": {"init": 0, "next": "!st ? 0 : q_dist + adv"},
    "q_x": {"init": 0, "next": "!st ? floor((w - 2 * gs) / gs) * gs : (q_arr ? q_nx + q_ndx * (adv - q_rem) : q_x + q_dx * adv)"},
    "q_y": {"init": 0, "next": "!st ? floor((h - 2 * gs) / gs) * gs : (q_arr ? q_ny + q_ndy * (adv - q_rem) : q_y + q_dy * adv)"},
    "q_dx": {"init": 0, "next": "!st ? -1 : (q_arr ? q_ndx : q_dx)"},
    "q_dy": {"init": 0, "next": "!st ? 0 : (q_arr ? q_ndy : q_dy)"},
    "q_rem": {"init": 0, "next": "!st ? gs : (q_arr ? gs - (adv - q_rem) : q_rem - adv)"},
    "ta": {"init": 0, "next": "st ? ta + (mode - ta) * 0.15 : ta"},
    "st": {"init": 0, "next": "st || (r > 4 && dt > 0 && t > 0.6)"},
    "rot": {"init": 0, "next": "rot + dt * (12 + 140 * think)"},
    "pulse": "1 + 0.08 * level",
    "lit": "floor(mod(t * 6, 8))"
  },
  "items": [
    {"type": "line", "note": "grid, vertical", "repeat": 40, "as": "i", "if": "gs >= 4 && i * gs <= w", "round": false, "x1": "i * gs", "y1": 0, "x2": "i * gs", "y2": "h", "width": 1, "color": "cyan", "alpha": 0.1},
    {"type": "line", "note": "grid, horizontal", "repeat": 40, "as": "i", "if": "gs >= 4 && i * gs <= h", "round": false, "x1": 0, "y1": "i * gs", "x2": "w", "y2": "i * gs", "width": 1, "color": "cyan", "alpha": 0.1},
    {"type": "line", "note": "cyan light trail: from the head back through its last corners, 6.3 cells long", "repeat": 9, "as": "j", "if": "st && da < trail && db > da", "let": {"ax": "j == 0 ? p_x : prev(p_cx, j - 1)", "ay": "j == 0 ? p_y : prev(p_cy, j - 1)", "bx": "prev(p_cx, j)", "by": "prev(p_cy, j)", "da": "j == 0 ? 0 : p_dist - prev(p_cd, j - 1)", "db": "p_dist - prev(p_cd, j)", "kf": "db > da ? clamp((trail - da) / (db - da), 0, 1) : 0"}, "x1": "ax", "y1": "ay", "x2": "ax + (bx - ax) * kf", "y2": "ay + (by - ay) * kf", "width": 3, "color": "cyan", "alpha": "ta"},
    {"type": "rect", "note": "cyan trail head", "if": "st", "x1": "p_x - 4", "y1": "p_y - 4", "x2": "p_x + 3", "y2": "p_y + 3", "color": "white", "alpha": "ta"},
    {"type": "line", "note": "orange light trail: from the head back through its last corners, 6.3 cells long", "repeat": 9, "as": "j", "if": "st && da < trail && db > da", "let": {"ax": "j == 0 ? q_x : prev(q_cx, j - 1)", "ay": "j == 0 ? q_y : prev(q_cy, j - 1)", "bx": "prev(q_cx, j)", "by": "prev(q_cy, j)", "da": "j == 0 ? 0 : q_dist - prev(q_cd, j - 1)", "db": "q_dist - prev(q_cd, j)", "kf": "db > da ? clamp((trail - da) / (db - da), 0, 1) : 0"}, "x1": "ax", "y1": "ay", "x2": "ax + (bx - ax) * kf", "y2": "ay + (by - ay) * kf", "width": 3, "color": "orange", "alpha": "ta"},
    {"type": "rect", "note": "orange trail head", "if": "st", "x1": "q_x - 4", "y1": "q_y - 4", "x2": "q_x + 3", "y2": "q_y + 3", "color": "white", "alpha": "ta"},
    {"type": "disc", "note": "dark fill hides the trails behind the disc", "x": "cx", "y": "cy", "radius": "max(1, r * 1.62 * pulse)", "color": "back"},
    {"type": "arc", "note": "outer glow", "x": "cx", "y": "cy", "radius": "r * 1.5 * pulse + 11", "width": 22, "color": "cyan", "alpha": 0.15},
    {"type": "arc", "note": "outer ring", "x": "cx", "y": "cy", "radius": "r * 1.5 * pulse + 3", "width": 6, "color": "cyan", "alpha": 0.95},
    {"type": "arc", "note": "eight segments light with the voice; one runs round while thinking", "repeat": 8, "as": "k", "let": {"band": "0.5 + 0.5 * sin(t * (5 + k * 1.3) + k * 2)", "on": "(1 - mode) * clamp01(level * 1.4 * band) + think * (k == lit ? 1 : 0.35) + answer * (0.3 + 0.7 * level * band)", "s": "rot + k * 45 + 3.5"}, "x": "cx", "y": "cy", "radius": "r * 1.12 * pulse + 4", "start": "s", "end": "s + 38", "width": 8, "color": "mod(k, 2) == 1 ? cyan : white", "alpha": "0.2 + 0.8 * on"},
    {"type": "arc", "note": "inner ring", "x": "cx", "y": "cy", "radius": "r * 0.62 * pulse + 1.5", "width": 3, "color": "cyan", "alpha": 0.9},
    {"type": "arc", "note": "core", "x": "cx", "y": "cy", "radius": "r * 0.32 * (1 + 0.4 * level) + 1.5", "width": 3, "color": "orange", "alpha": "0.3 + 0.6 * level"}
  ]
}
