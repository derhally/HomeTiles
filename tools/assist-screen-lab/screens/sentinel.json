{
  "format": 1,
  "id": "sentinel",
  "name": "Sentinel",
  "note": "A heads-up display. 72 ticks around the core rise with the voice inside broken rings and a turning triangle; while thinking the rings spin up, an amber arc races and a scan line sweeps; while answering the ticks pulse in waves. Readouts on both sides.",
  "needs": ["wide"],
  "label_color": "#E8FBFF",
  "reach": {"half_r": 3.95, "side_r": 3.27, "side_px": 110},
  "colors": {"cyan": "#5CE1FF", "amber": "#FFB547", "white": "#E8FBFF"},
  "vars": {
    "answer": {"init": 0, "next": "answer + (answering - answer) * 0.12"},
    "think": "max(0, mode - answer)",
    "a": "answer",
    "lv": "level",
    "m": "mode",
    "head": "mod(t * 2.4, tau)",
    "peak": {"init": 0, "next": "max(level, peak * 0.985)"},
    "lx": "cx + r * 1.66 * cos(pi * 1.08)",
    "ly": "cy + r * 1.66 * sin(pi * 1.08)",
    "rx": "cx + r * 1.66 * cos(-pi * 0.08)",
    "ry": "cy + r * 1.66 * sin(-pi * 0.08)",
    "by": "ly - 0.3 * r",
    "bx": "cx - 3.95 * r",
    "hx": "cx + 3.27 * r",
    "tri": "t * (0.3 + 2.2 * think) - pi / 2",
    "lit": "floor(level * 10 + 0.5)"
  },
  "items": [
    {"type": "group", "if": "r >= 2", "items": [
      {"type": "arc", "note": "guide circle", "x": "cx", "y": "cy", "radius": "r * 1.66", "width": 1, "color": "cyan", "alpha": 0.14},

      {"type": "line", "note": "tick spectrum", "repeat": 72, "as": "i",
       "let": {
         "slot": "i * tau / 72",
         "ang": "slot - pi / 2",
         "freq": "3 + hash(i, 1) * 6",
         "phase": "hash(i, 2) * tau",
         "wave": "(0.5 + 0.5 * sin(t * freq + phase)) * (0.55 + 0.45 * sin(ang * 4 + t * 3))",
         "diff": "mod(head - slot, tau)",
         "trail": "diff < 1.7 ? 1 - diff / 1.7 : 0",
         "ans_wave": "0.5 + 0.5 * sin(ang * 6 - t * 8)",
         "len": "r * (0.06 + (1 - m) * lv * wave * 0.42 + a * lv * ans_wave * 0.30 + think * trail * 0.14)",
         "r0": "r * 1.45",
         "c": "cos(ang)",
         "s": "sin(ang)"
       },
       "x1": "cx + r0 * c", "y1": "cy + r0 * s", "x2": "cx + (r0 + len) * c", "y2": "cy + (r0 + len) * s",
       "width": 3, "round": false,
       "color": "(1 - m) * lv * wave > 0.62 ? amber : (think * trail > 0.9 ? white : cyan)",
       "alpha": "0.3 + 0.7 * clamp01((1 - m) * (wave * lv * 1.4 + 0.15) + think * trail + a * (0.3 + 0.7 * lv * ans_wave))"},

      {"type": "arc", "note": "broken ring, faster while thinking", "repeat": 4, "as": "k", "glow": true,
       "let": {"s": "t * (10 + 92 * think) + a * sin(t * 2) * 12 + k * 90"},
       "x": "cx", "y": "cy", "radius": "r * 1.2 * (1 + 0.06 * lv)", "start": "s", "end": "s + 62",
       "width": 3, "color": "cyan", "alpha": 0.85},

      {"type": "arc", "note": "dashed inner ring, counter-turning", "repeat": 24, "as": "k", "round": false,
       "let": {"s": "-t * (6 + 57 * think) + k * 15"},
       "x": "cx", "y": "cy", "radius": "r", "start": "s", "end": "s + 5", "width": 2, "color": "cyan", "alpha": 0.55},

      {"type": "arc", "note": "amber racers while thinking", "glow": true,
       "x": "cx", "y": "cy", "radius": "r * 1.66", "start": "t * 240", "end": "t * 240 + 34",
       "width": 4, "color": "amber", "alpha": "think * 0.95"},
      {"type": "arc", "glow": true,
       "x": "cx", "y": "cy", "radius": "r * 1.66", "start": "-t * 168", "end": "-t * 168 + 20",
       "width": 2, "color": "amber", "alpha": "think * 0.6"},

      {"type": "line", "note": "scan line while thinking", "glow": true,
       "let": {"hc": "cos(head - pi / 2)", "hs": "sin(head - pi / 2)"},
       "x1": "cx + r * 0.7 * hc", "y1": "cy + r * 0.7 * hs", "x2": "cx + r * 1.4 * hc", "y2": "cy + r * 1.4 * hs",
       "width": 2, "color": "white", "alpha": "think * 0.7"},

      {"type": "arc", "note": "core outline", "glow": true, "x": "cx", "y": "cy",
       "radius": "r * (0.62 + 0.10 * lv * (1 - think))", "width": 3, "color": "cyan", "alpha": 0.9},
      {"type": "disc", "x": "cx", "y": "cy", "radius": "r * 0.50 * (1 + 0.45 * lv)", "color": "cyan", "alpha": "0.12 + 0.25 * lv"},
      {"type": "disc", "x": "cx", "y": "cy", "radius": "r * 0.36 * (1 + 0.45 * lv)", "color": "cyan", "alpha": "0.22 + 0.25 * lv"},
      {"type": "disc", "x": "cx", "y": "cy", "radius": "r * 0.22 * (1 + 0.45 * lv)", "color": "cyan", "alpha": "0.50 + 0.25 * lv"},
      {"type": "disc", "x": "cx", "y": "cy", "radius": "r * (0.10 + 0.08 * lv)", "color": "white", "alpha": 0.9},

      {"type": "line", "note": "turning triangle", "repeat": 3, "as": "k", "glow": true,
       "let": {"a0": "tri + k * tau / 3", "a1": "tri + (k + 1) * tau / 3"},
       "x1": "cx + r * 0.45 * cos(a0)", "y1": "cy + r * 0.45 * sin(a0)",
       "x2": "cx + r * 0.45 * cos(a1)", "y2": "cy + r * 0.45 * sin(a1)",
       "width": 2, "color": "white", "alpha": 0.8}
    ]},

    {"type": "poly", "note": "left callout", "round": false, "width": 2, "color": "cyan", "alpha": 0.59,
     "points": [["lx", "ly"], ["lx - 0.4 * r", "by"], ["cx - 3.15 * r", "by"]]},
    {"type": "poly", "note": "right callout", "round": false, "width": 2, "color": "cyan", "alpha": 0.59,
     "points": [["rx", "ry"], ["rx + 0.4 * r", "ry - 0.3 * r"], ["cx + 3.15 * r", "ry - 0.3 * r"]]},

    {"type": "text", "note": "level readout", "x": "bx", "y": "by - 0.38 * r", "width": 90, "font": 32,
     "text": "{lv * 100:03d}", "color": "white", "every": 4},
    {"type": "text", "x": "bx + 0.78 * r", "y": "by - 0.2 * r", "width": 90, "font": 16,
     "text": "PK {peak * 100:03d}", "color": "cyan", "alpha": 0.7, "every": 4},
    {"type": "rect", "note": "level meter", "repeat": 10, "as": "k",
     "let": {"mx": "bx + 0.03 * r + k * 0.08 * r", "my": "by + 0.24 * r", "mw": "max(2, 0.05 * r)", "mh": "max(2, 0.14 * r)"},
     "x1": "floor(mx) - floor(mw / 2)", "y1": "floor(my) - floor(mh / 2)",
     "x2": "floor(mx) - floor(mw / 2) + floor(mw) - 1", "y2": "floor(my) - floor(mh / 2) + floor(mh) - 1",
     "color": "k >= 8 ? amber : cyan", "alpha": "k < lit ? 0.9 : 0.15"},

    {"type": "log", "note": "hex column, faster while thinking", "x": "hx", "y": "ry - 0.38 * r", "rows": 4,
     "line_height": "0.18 * r", "width": 110, "font": 16, "fill": true,
     "line": "{rand(0, 255):02X} {rand(0, 255):02X}", "every": "mode - answer > 0.5 ? 3 : 18",
     "color": "k == 3 ? amber : cyan", "alpha": "(115 + k * 38) / 255"},
    {"type": "text", "note": "clock", "x": "hx", "y": "ry + 0.36 * r", "width": 110, "font": 16,
     "text": "T+{mod(t, 100):04.1f}", "color": "cyan", "alpha": 0.59, "every": 4}
  ]
}
